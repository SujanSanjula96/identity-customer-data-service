# The deployment file for the manual mode of start-performance.sh (-O).
#
# 1. Copy this file to your run directory, for example
#    <run dir>/deployment.env, and run: chmod 600 deployment.env
# 2. Write the stack name, and the values from the Outputs tab of the stack in
#    the AWS CloudFormation console. The keys have the same names as the outputs.
# 3. Write the DBUsername, CDSDBPassword, and ISDBPassword values that you gave
#    as stack parameters.
#
# Do not commit a filled copy of this file. It has passwords.

STACK_NAME=cds-perf-1node-example

# The DeploymentSize parameter of the stack: performance or smoke. With smoke
# and no test options after --, the start script runs a short test.
DeploymentSize=performance

# Outputs tab
BastionPublicIp=
NginxPrivateIp=
ISPrivateIp=
# Only for a stack with ISNodeCount=2 (the two node and three node patterns):
ISNode2PrivateIp=
ActiveMQPrivateIp=
CDSNode1PrivateIp=
# Only for the two node and three node patterns:
CDSNode2PrivateIp=
CDSNode3PrivateIp=
CDSDBEndpoint=
ISDBEndpoint=

# Parameters tab (the values that you typed when you created the stack)
DBUsername=perfadmin
CDSDBPassword=
ISDBPassword=
