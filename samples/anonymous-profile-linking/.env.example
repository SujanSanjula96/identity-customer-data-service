# Copy to .env and fill in. See README.md for how to obtain each value.

PORT=3000
APP_BASE_URL=http://localhost:3000

# --- CDS ---
CDS_BASE_URL=https://localhost:8900
CDS_ORG_HANDLE=carbon.super
CDS_APPLICATION_ID=<client_id of the OIDC app registered in CDS>

# --- Machine-to-machine client (backend -> CDS) ---
# Needs internal_cds_profile_create, internal_cds_profile_update,
# internal_cds_profile_link.
M2M_TOKEN_ENDPOINT=https://localhost:9443/oauth2/token
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=
M2M_SCOPES=internal_cds_profile_create internal_cds_profile_update internal_cds_profile_link

# --- User-facing OIDC client (browser -> Identity Server) ---
OIDC_AUTHORIZATION_ENDPOINT=https://localhost:9443/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://localhost:9443/oauth2/token
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile

# --- Local development only ---
# Both default to off. Read the README before turning either on.
DEV_INSECURE_COOKIES=false
ALLOW_SELF_SIGNED_TLS=false
